.head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 18rpx;
}
.issue {
  font-size: 38rpx;
  font-weight: 600;
  margin-right: 14rpx;
}
.game {
  font-size: 24rpx;
  color: #8a8f99;
}
.date {
  font-size: 25rpx;
  color: #5f6672;
}

.balls {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}
.balls .ball {
  margin-bottom: 8rpx;
}

.prize-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid #eef0f3;
  font-size: 25rpx;
}
.prize-header {
  border-top: none;
  color: #8a8f99;
  font-size: 23rpx;
  padding-bottom: 8rpx;
}
.col-label {
  flex: 1.6;
  display: flex;
  flex-direction: column;
}
.prize-label {
  font-weight: 600;
}
.prize-cond {
  font-size: 21rpx;
  color: #8a8f99;
  margin-top: 2rpx;
}
.col-count {
  flex: 0.6;
  text-align: right;
  color: #5f6672;
}
.col-amount {
  flex: 1;
  text-align: right;
}

.center {
  text-align: center;
  padding: 40rpx 0;
}
.link {
  color: #1f6feb;
}
