.chat-page {
  padding-bottom: 40rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}
.new-btn {
  font-size: 24rpx;
  color: #1f6feb;
  border: 1rpx solid #cfe0ff;
  background: #f7faff;
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
}

.intro .chip {
  display: block;
  font-size: 26rpx;
  color: #1f6feb;
  background: #f5f9ff;
  border: 1rpx solid #e2ecff;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
}

.msg {
  display: flex;
  flex-direction: column;
  margin-bottom: 22rpx;
}
.msg.user {
  align-items: flex-end;
}
.msg.assistant {
  align-items: flex-start;
}
.bubble {
  max-width: 86%;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  line-height: 1.65;
  word-break: break-word;
  white-space: pre-wrap;
}
.msg.user .bubble {
  background: #1f6feb;
  color: #ffffff;
  border-bottom-right-radius: 6rpx;
}
.msg.assistant .bubble {
  background: #ffffff;
  color: #1f2329;
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, 0.04);
}
.thinking {
  color: #8a8f99;
}
.tools {
  font-size: 21rpx;
  color: #a0a6b1;
  margin-top: 8rpx;
  padding-left: 8rpx;
}

.error {
  background: #fdf7f7;
  border-left: 6rpx solid #c62828;
}
.error-title {
  font-weight: 600;
  margin-bottom: 6rpx;
  color: #c62828;
}

.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -2rpx 12rpx rgba(16, 24, 40, 0.06);
}
.chat-input {
  flex: 1;
  background: #f4f5f7;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 27rpx;
}
.send {
  margin-left: 16rpx;
  background: #1f6feb;
  color: #ffffff;
  font-size: 27rpx;
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
}
.send.disabled {
  background: #b6bcc6;
}
