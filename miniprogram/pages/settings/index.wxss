.ok {
  color: #2e7d32;
}
.warn {
  color: #b26a00;
}
.mono {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 22rpx;
  max-width: 420rpx;
  word-break: break-all;
  text-align: right;
}
.btn {
  margin-top: 24rpx;
  text-align: center;
  border: 1rpx solid #1f6feb;
  color: #1f6feb;
  border-radius: 12rpx;
  padding: 18rpx 0;
  font-size: 27rpx;
}

.index-group {
  margin-top: 12rpx;
}
.index-coll {
  font-size: 24rpx;
  font-weight: 600;
  color: #3f4652;
  margin-bottom: 4rpx;
}
.index-item {
  font-size: 22rpx;
  line-height: 1.6;
  padding-left: 8rpx;
}
