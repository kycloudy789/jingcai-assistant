# 复制为 .env（本地）或在云函数控制台直接配置环境变量。
# 严禁把真实密钥写入本文件、源码、日志或 Git。
# 本文件不含任何真实值。

# DeepSeek（仅云函数运行环境使用，前端永不接触）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_MS=20000
DEEPSEEK_MAX_TOOL_ROUNDS=3

# 单用户白名单（阶段 1 过渡方案；阶段 2 建库后改用 app_config.ownerWhitelist）
OWNER_OPENID=

# CloudBase
TCB_ENV_ID=
